; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[addons]

resources_spreadsheet_view/array_color_tint=100.0
resources_spreadsheet_view/color_rows=true
resources_spreadsheet_view/array_min_width=128.0
resources_spreadsheet_view/resource_preview_size=32.0
resources_spreadsheet_view/clip_headers=false
resources_spreadsheet_view/dupe_arrays=true
resources_spreadsheet_view/context_menu_on_leftclick=false
resources_spreadsheet_view/fold_docks=true
resources_spreadsheet_view/resource_cell_label_mode=1
resources_spreadsheet_view/freeze_first_column=true

[application]

config/name="Exploria"
run/main_scene="uid://cugcbkyhuyq3x"
config/use_custom_user_dir=true
config/custom_user_dir_name="Exploria"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.0247816, 0.0137748, 0.0616549, 1)
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/image="uid://b04bf24wjnnha"
config/icon="res://icon.svg"

[autoload]

PhantomCameraManager="*res://addons/phantom_camera/scripts/managers/phantom_camera_manager.gd"
Console="*res://addons/console/console.gd"
Scene="*res://Assets/Scripts/loading/loading.tscn"
Notification="*res://Assets/Scripts/Notifications/notification_panel.tscn"
Global="*res://Assets/Scripts/Global.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://dtndnd7yxc011"

[editor_plugins]

enabled=PackedStringArray("res://addons/console/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/resources_spreadsheet_view/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Assets/Audio/": "pink",
"res://Assets/Locations/": "teal",
"res://Assets/Misc/": "green",
"res://Assets/Scripts/": "blue",
"res://Assets/Shaders/": "red",
"res://Assets/Sprites/": "yellow",
"res://Assets/UI/": "purple",
"res://addons/": "gray"
}

[gui]

theme/custom_font="uid://cb03qdh67fmky"

